#: commandHelper/__init__.py:136
msgid "Command helper"
msgstr "Komut yardımcısı"

#. TRANSLATORS: The configuration option in NVDA Preferences menu
#. TRANSLATORS: Settings dialog title
#: commandHelper/__init__.py:147 commandHelper/__init__.py:723
msgid "Command Helper settings"
msgstr "Komut Yardımcısı ayarları"

#: commandHelper/__init__.py:292
msgid "Available commands"
msgstr "Kullanılabilir komutlar"

#: commandHelper/__init__.py:302 commandHelper/__init__.py:504
msgid "Failed to retrieve scripts."
msgstr "Komut alınamadı."

#: commandHelper/__init__.py:306 commandHelper/__init__.py:307
#: commandHelper/__init__.py:612
msgid "Recents"
msgstr "Son"

#. TRANSLATORS: message shown in Input gestures dialog for this script
#: commandHelper/__init__.py:337
msgid ""
"Provides a virtual menu where you can select any command to be executed "
"without having to press its gesture."
msgstr ""
"Hareketine basmak zorunda kalmadan yürütülecek herhangi bir komutu "
"seçebileceğiniz sanal bir menü sağlar."

#: commandHelper/__init__.py:392
msgid ""
"No matches found. Press the space bar to perform another search or escape to "
"return to the full menu."
msgstr ""
"Hiçbir şey bulunamadı. Başka bir arama yapmak için boşluk çubuğuna veya ana "
"menüye dönmek için Escape tuşuna basın."

#: commandHelper/__init__.py:401
msgid ""
"No results. Press the space bar to perform another search or escape to "
"return to the full menu."
msgstr ""
"Bir şey bulunamadı. Başka bir arama yapmak için boşluk çubuğuna veya ana "
"menüye dönmek için Escape tuşuna basın."

#: commandHelper/__init__.py:410 commandHelper/__init__.py:535
msgid "Select a command using up or down arrows"
msgstr "Yukarı veya aşağı ok tuşlarını kullanarak bir komut seçin"

#: commandHelper/__init__.py:438 commandHelper/__init__.py:470
#: commandHelper/__init__.py:473
msgid "Can't run this script here"
msgstr "Bu komutu burada çalıştıramazsınız"

#: commandHelper/__init__.py:446
msgid ""
"Can't run this script while the corresponding braille driver is not active"
msgstr "İlgili braille sürücüsü etkin değilken bu komut çalıştırılamaz"

#: commandHelper/__init__.py:457
msgid "Can't run this script while the corresponding provider is not enabled"
msgstr "İlgili sağlayıcı etkinleştirilmediğinde bu komut çalıştırılamaz"

#: commandHelper/__init__.py:467
msgid "Can't run this script while in focus mode"
msgstr "Bu komut odak modundayken çalıştırılamaz"

#: commandHelper/__init__.py:547
msgid "There is no gesture"
msgstr "Tanımlı kısa yol yok"

#: commandHelper/__init__.py:560
#, python-format
msgid ""
"Use up and down arrows to select a script and enter to run the selected. %s "
"to clear filter and return to full menu. Press space to perform another "
"voice search."
msgstr ""
"Bir komut seçmek için yukarı ve aşağı ok tuşlarını kullanın ve seçileni "
"çalıştırmak için enter'a basın. Filtreyi temizlemek ve tam menüye dönmek "
"için %s. Başka bir sesli arama yapmak için boşluk tuşuna basın."

#: commandHelper/__init__.py:562
#, python-format
msgid ""
"Use right and left arrows to navigate categories, up and down arrows to "
"select a script and enter to run the selected. %s to exit."
msgstr ""
"Kategoriler arasında  gezinmek için sağ sol okları, bir komut seçmek için "
"yukarı aşağı okları ve seçileni çalıştırmak için enter'i kullanın. Çıkış "
"için %s tuşunu kullanın."

#: commandHelper/__init__.py:567
msgid "Returning to the full menu"
msgstr "Ana menüye dönüldü"

#: commandHelper/__init__.py:574
msgid "Leaving the command hhelper"
msgstr "Komut yardımcısından çıkıldı"

#: commandHelper/__init__.py:582
msgid "Unavailable feature"
msgstr "Bu özellik kullanılamıyor"

#: commandHelper/__init__.py:587
msgid "Speak now"
msgstr "Şimdi konuşun"

#: commandHelper/__init__.py:591
msgid "Nothing was heard. Make sure the microphone is connected and try again."
msgstr ""
"Hiçbir şey duyulmadı. Mikrofonun bağlı olduğundan emin olun ve tekrar "
"deneyin."

#: commandHelper/__init__.py:596
msgid "Unable to recognize"
msgstr "Tanınamadı"

#: commandHelper/__init__.py:599
msgid "Could not connect. Check your internet connection."
msgstr "Bağlanamadı. İnternet bağlantınızı kontrol edin."

#: commandHelper/__init__.py:619
#, python-format
msgid "%d matches found for %s"
msgstr "%d matches found for %s"

#: commandHelper/__init__.py:627
#, python-format
msgid "No matches found for %s"
msgstr "%s için eşleşme bulunamadı"

#. TRANSLATORS: Checkbox to enable or disable helper launching by control key
#: commandHelper/__init__.py:664
msgid "Control key launches the helper"
msgstr "Kontrol tuşu yardımcıyı başlatır"

#: commandHelper/__init__.py:667
msgid ""
"With the control key activated, it is recommended to reduce the keyboard "
"repetition speed. See more information in the addon documentation."
msgstr ""
"Kontrol tuşu etkinleştirildiğinde klavye tekrarlama hızının düşürülmesi "
"önerilir. Eklenti belgelerinde daha fazla bilgi bulabilirsiniz."

#: commandHelper/__init__.py:670
msgid "Windows keyboard settings"
msgstr "Windows klavye ayarları"

#: commandHelper/__init__.py:672
msgid "Open the Windows control panel to adjust keyboard parameters"
msgstr "Klavye parametrelerini ayarlamak için Windows kontrol panelini açın"

#: commandHelper/__init__.py:676
msgid "Key to leave the keyboard command layer"
msgstr "Klavye komut katmanını kapatma tuşu"

#: commandHelper/__init__.py:676
msgid "escape"
msgstr "escape"

#: commandHelper/__init__.py:676
msgid "backspace"
msgstr "geri Sil tuşu"

#: commandHelper/__init__.py:678
msgid "Choose which key to use to exit the helper."
msgstr "Yardımcıdan çıkmak için hangi tuşun kullanılacağını seçin."

#: commandHelper/__init__.py:680
msgid "Key to report the gesture assigned to a command"
msgstr "Bir komuta atanan hareketi seslendirme tuşu"

#: commandHelper/__init__.py:680
msgid "F1"
msgstr "F1"

#: commandHelper/__init__.py:680
msgid "F12"
msgstr "F12"

#: commandHelper/__init__.py:682
msgid ""
"Choose which key to use to announce the gesture assigned to the command."
msgstr ""
"Komuta atanan hareketi duyurmak için hangi tuşun kullanılacağını seçin."

#: commandHelper/__init__.py:684
msgid "Use numpad in the keyboard command layer"
msgstr "Klavye komut katmanında sayısal tuş takımını kullan"

#: commandHelper/__init__.py:686
msgid "Use the numeric keyboard in the command layer."
msgstr "Komut katmanında sayısal klavyeyi kullanın."

#. TRANSLATORS: Settings panel title
#: commandHelper/__init__.py:710
msgid "Command Helper"
msgstr "Komut Yardımcısı"

